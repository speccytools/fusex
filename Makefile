	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(icons64dir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(icons64dir)" || exit $$?; \
	done

